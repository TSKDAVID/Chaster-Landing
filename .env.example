# Copy to .env.local and fill in. Nothing here is a secret: NEXT_PUBLIC_* values are shipped to the browser.
# Until the owner answers the open questions (DESIGN-GUIDELINES §1.18) these defaults point at reserved
# example domains so no link can land on a stranger's site.

# Canonical origin of this landing page (canonical URLs, sitemap, Open Graph).   §1.18 #1
NEXT_PUBLIC_SITE_URL=https://chaster.example

# Where "connect your page" lands. It must read ?modules=catalog,media&for=shop&lang=ka   §1.18 #1
NEXT_PUBLIC_APP_URL=https://app.chaster.example

# Chaster's own pages, for the live demo, the founder band, the footer and the QR code.   §1.18 #5
NEXT_PUBLIC_MESSENGER_URL=https://m.me/chaster.example
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/chaster.example

# Meta Pixel. Empty means no pixel and no events leave the browser.   §1.18 #13
NEXT_PUBLIC_META_PIXEL_ID=

# Events wait for consent unless this is exactly "false". Confirm with a lawyer before turning it off.   §1.18 #13
NEXT_PUBLIC_CONSENT_REQUIRED=true
